{
    "name": "tinytank/framework",
    "description": "TinyTank: a tiny, database-free PHP micro framework for static-like dynamic sites (Datastar, Symfony Routing, Twig, Markdown blog, translations, SEO), compiled for Opcache.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "framework",
        "datastar",
        "twig",
        "static",
        "markdown",
        "blog",
        "opcache"
    ],
    "homepage": "https://tinytank.dev/",
    "support": {
        "docs": "https://tinytank.dev/",
        "source": "https://github.com/tinytankphp/framework",
        "issues": "https://github.com/tinytankphp/framework/issues"
    },
    "require": {
        "php": ">=8.4",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-xmlwriter": "*",
        "intervention/image": "^4.3",
        "league/commonmark": "^2.8",
        "monolog/monolog": "^3.9",
        "psr/container": "^2.0",
        "spatie/schema-org": "^5.0",
        "starfederation/datastar-php": "^1.0",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/error-handler": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-csrf": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/yaml": "^7.4",
        "twig/intl-extra": "^3.10",
        "twig/twig": "^3.10"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "ext-gd": "Responsive images (GD or Imagick, with WebP; AVIF where available)",
        "ext-imagick": "Responsive images (Imagick or GD), used when both are installed",
        "phpunit/phpunit": "For TinyTank\\Testing\\KernelTestCase in your app's tests"
    },
    "autoload": {
        "psr-4": {
            "TinyTank\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TinyTank\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
